          {
            "text": "Permanently",
            "styles": [
              "underline"
            ]
          },
          {
            "text": ".",
            "styles": []
          }
        ]
      }
    },
    {
      "type": "action",
      "text": {
        "runs": [
          {
            "text": "Jack begins to argue vociferously in Vietnamese (?), But mercifully we...",
