      "type": "parenthetical",
      "text": {
        "runs": [
          {
            "text": "(in Vietnamese, subtitled)",
            "styles": []
          }
        ]
      }
    },
    {
      "type": "dialogue",
      "text": {
        "runs": [
          {
            "text": "Did you know Brick and Steel are retired?",
            "styles": [
              "italic"
