{
  "name": "@bantam-hq/featherweight",
  "version": "0.0.0",
  "description": "Recover semantic screenplay documents from PDFs.",
  "type": "module",
  "license": "MIT",
  "author": "Bantam HQ",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "featherweight": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "pdf",
    "screenplay",
    "fountain",
    "scriptwriting"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "1.11.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
